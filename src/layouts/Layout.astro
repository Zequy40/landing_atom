---
const {
  title = "AtomDigital",
  description = "Landing + Setter IA 24/7 + Automatizaciones para clínicas dentales.",
} = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">
</head>

    <style>
      :root{
        --bg:#060311;
        --panel: rgba(255,255,255,.06);
        --line: rgba(255,255,255,.10);
        --text:#eef0ff;
        --muted: rgba(238,240,255,.70);
        --shadow: 0 24px 60px rgba(0,0,0,.55);
        --r: 22px;

        --a:#a78bfa; /* violeta */
        --b:#f0abfc; /* rosa */
        --c:#22d3ee; /* cian */
      }

      *{box-sizing:border-box}
      html,body{height:100%}
      body{
        margin:0;
        font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;
        color:var(--text);
        background: var(--bg);
      }

      /* Fondo tipo “glow” como la referencia */
      .bg{
        position: fixed;
        inset: 0;
        overflow:hidden;
        z-index:-1;
      }
      .glow{
        position:absolute;
        border-radius:999px;
        filter: blur(70px);
        opacity:.55;
        transform: translateZ(0);
      }
      .g1{ width:560px; height:560px; left:-120px; top:-180px; background: radial-gradient(circle at 30% 30%, var(--a), transparent 60%); }
      .g2{ width:520px; height:520px; right:-160px; top:-120px; background: radial-gradient(circle at 40% 40%, var(--b), transparent 62%); }
      .g3{ width:640px; height:640px; left:18%; bottom:-260px; background: radial-gradient(circle at 30% 30%, var(--c), transparent 62%); opacity:.35; }

      a{color:inherit}
      .wrap{max-width:1120px; margin:0 auto; padding:0 18px;}

      .nav{
        position:sticky; top:0; z-index:50;
        border-bottom:1px solid rgba(255,255,255,.06);
        background: rgba(6,3,17,.55);
        backdrop-filter: blur(10px);
      }
      .navin{
        display:flex; align-items:center; justify-content:space-between;
        padding:16px 0; gap:12px;
      }
      .brand{
        display:flex; align-items:center; gap:10px;
        text-decoration:none;
      }
      .logo{
        width:36px; height:36px; border-radius:14px;
        background: linear-gradient(135deg, var(--a), var(--b));
        box-shadow: 0 18px 40px rgba(0,0,0,.4);
      }
      .brand strong{letter-spacing:-.2px}

      .pillnav{
        display:flex; gap:10px; align-items:center;
        padding:10px;
        border:1px solid rgba(255,255,255,.08);
        background: rgba(255,255,255,.04);
        border-radius:999px;
      }
      .pillnav a{
        text-decoration:none;
        color: var(--muted);
        font-size:14px;
        padding:8px 12px;
        border-radius:999px;
      }
      .pillnav a:hover{
        color: var(--text);
        background: rgba(255,255,255,.05);
      }

      .btn{
        display:inline-flex; align-items:center; justify-content:center; gap:10px;
        padding:12px 16px;
        border-radius: 999px;
        border:1px solid rgba(255,255,255,.14);
        background: rgba(255,255,255,.06);
        text-decoration:none;
        font-weight:800;
      }
      .btn:hover{border-color:rgba(255,255,255,.22)}
      .btn.grad{
        border:none;
        color:#0a0716;
        background: linear-gradient(135deg, var(--a), var(--b));
      }

      .panel{
        border:1px solid rgba(255,255,255,.10);
        background: rgba(255,255,255,.05);
        border-radius: var(--r);
        box-shadow: var(--shadow);
        backdrop-filter: blur(10px);
      }

      footer{
        border-top:1px solid rgba(255,255,255,.06);
        padding:26px 0 44px;
        color: rgba(238,240,255,.55);
        font-size: 13px;
      }

      @media (max-width: 920px){
        .pillnav{display:none}
      }
    </style>
  </head>
  <body>
    <div class="bg" aria-hidden="true">
      <div class="glow g1"></div>
      <div class="glow g2"></div>
      <div class="glow g3"></div>
    </div>

    <div class="nav">
      <div class="wrap">
        <div class="navin">
          <a class="brand" href="#top">
            <span class="logo" aria-hidden="true"></span>
            <strong>AtomDigital</strong>
          </a>

          <nav class="pillnav" aria-label="Navegación">
            <a href="#beneficios">Beneficios</a>
            <a href="#pack">Pack</a>
            <a href="#cta">WhatsApp</a>
          </nav>

          <a class="btn grad" href="#cta">Hablar por WhatsApp</a>
        </div>
      </div>
    </div>

    <main id="top">
      <slot />
    </main>

    <footer>
      <div class="wrap" style="display:flex; flex-wrap:wrap; gap:10px; justify-content:space-between; align-items:center;">
        <div>© {new Date().getFullYear()} AtomDigital</div>
        <div>Automatizaciones + Setter IA + Landings</div>
      </div>
    </footer>
  </body>
</html>
